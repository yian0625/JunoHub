JUNOHUB_BIND=0.0.0.0:9003
JUNOHUB_DATABASE_URL=sqlite://junohub.db?mode=rwc
JUNOHUB_JWT_SECRET=replace-this-in-production
JUNOHUB_BOOTSTRAP_ADMIN_EMAIL=admin@junohub.local
JUNOHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
JUNOHUB_ENCRYPTION_KEY=replace-with-a-long-random-secret
RUST_LOG=junohub_server=info,tower_http=info

# Rust 账户引擎数据面（Docker 部署时由 Compose 提供，本地开发可指向可达实例）
