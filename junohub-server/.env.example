# Generate each secret independently: openssl rand -hex 32
JUNOHUB_BIND=0.0.0.0:9003
JUNOHUB_DATABASE_URL=sqlite://junohub.db?mode=rwc
JUNOHUB_JWT_SECRET=replace-with-at-least-32-random-characters
JUNOHUB_BOOTSTRAP_ADMIN_EMAIL=admin@junohub.local
JUNOHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
JUNOHUB_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
# 允许跨域访问后端 API 的浏览器来源（逗号分隔，只写 scheme://host[:port]）。
# 留空（默认）表示不放行任何跨域请求：Web 控制台经 Next.js 的 rewrite 同源
# 代理访问后端，浏览器不会跨域直连 9003，日常使用不需要这项配置。
# 只有确实要用浏览器脚本直连后端时才填，例如：JUNOHUB_ALLOWED_ORIGINS=https://hub.example.com
JUNOHUB_ALLOWED_ORIGINS=

RUST_LOG=junohub_server=info,tower_http=info
# TokenHub 图片适配的作用范围（可选）。留空表示不启用该适配 —— 代码里不内置
# 任何第三方供应商地址或模型名。需要时填上游主机名与它支持的模型，逗号分隔：
#   JUNOHUB_TOKENHUB_IMAGE_HOSTS=images.example.com
#   JUNOHUB_TOKENHUB_IMAGE_MODELS=gpt-image-2,gpt-image-2.5-sunburst
# 主机名只填裸主机名，不要带协议、端口或路径（带了会在启动时报错）。
JUNOHUB_TOKENHUB_IMAGE_HOSTS=
JUNOHUB_TOKENHUB_IMAGE_MODELS=

# Rust 账户引擎数据面（Docker 部署时由 Compose 提供，本地开发可指向可达实例）
# POSTGRES_USER=sub2api
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=sub2api
# SUB2API_DATABASE_URL=postgres://sub2api:change-me@127.0.0.1:5432/sub2api
# REDIS_PASSWORD=change-me
# SUB2API_REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# ADMIN_EMAIL=admin@sub2api.local

# 邮箱注册验证码：smtp 或 resend（只在后端使用）
JUNOHUB_EMAIL_PROVIDER=smtp
# Resend 方式使用以下配置
RESEND_API_KEY=
RESEND_FROM="JunoHub <noreply@example.com>"
# 每 24 小时全站最大发信尝试次数；邮箱提供商另有额度和风控限制
JUNOHUB_EMAIL_DAILY_LIMIT=100

# SMTP 注册验证码（后端配置；授权码不要提交 Git）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 图片存储：个人头像 JunoHub/user/，供应商头像 JunoHub/provider/
# 由服务端签名上传和读取，Bucket 可保持私有；凭据仅配置在服务端。
OSS_BUCKET=juno-app
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PREFIX=JunoHub
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 仅临时 STS 凭据需要此项
OSS_SECURITY_TOKEN=

# 专用 /metrics 采集凭据。留空时仅允许管理员 JWT。
JUNOHUB_METRICS_TOKEN=
