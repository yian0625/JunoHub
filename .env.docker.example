# 复制为 .env 后再启动（或直接运行 ./deploy.sh init）。以下四个值必须修改并长期保存。
JUNOHUB_JWT_SECRET=replace-with-at-least-32-random-characters
JUNOHUB_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
JUNOHUB_BOOTSTRAP_ADMIN_EMAIL=admin@junohub.local
JUNOHUB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# 允许跨域访问后端 API 的浏览器来源（逗号分隔，只写 scheme://host[:port]）。
# 留空（默认）表示不放行任何跨域请求：Web 控制台经 Next.js 的 rewrite 同源
# 代理访问后端，浏览器不会跨域直连 9003，日常使用不需要这项配置。
# 只有确实要用浏览器脚本直连后端时才填，例如：JUNOHUB_ALLOWED_ORIGINS=https://hub.example.com
JUNOHUB_ALLOWED_ORIGINS=

# 宿主机端口，可按需修改。
JUNOHUB_WEB_PORT=3003
JUNOHUB_API_PORT=9003

RUST_LOG=junohub_server=info,tower_http=info

# 日志明细保留天数：逐条请求日志、审计与告警的清理窗口。
# 只影响明细行；密钥上的累计请求数、token 与费用是累加值，不会被清理改变。
# 0 表示永久保留（不推荐：业务库是单个 SQLite 文件，会无限增长）。
JUNOHUB_LOG_RETENTION_DAYS=90

# 账户引擎并发槽 TTL（分钟）。槽位由每分钟的心跳续期，
# 这个值决定进程异常退出后槽位最长滞留多久，3 分钟足够且影响面小。
GATEWAY_CONCURRENCY_SLOT_TTL_MINUTES=3

# Rust 账户引擎数据面（原 Sub2API 的 PostgreSQL 与 Redis，Go 容器已移除）。
# 首次启动会用 deploy/accounts-schema.sql 初始化表结构。
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=sub2api
REDIS_PASSWORD=replace-with-a-strong-password
REDIS_DB=0
# Rust 引擎解析账户池归属时使用的管理员邮箱（对应 accounts 库 users 表）。
ADMIN_EMAIL=admin@sub2api.local

# 邮箱注册验证码：smtp 或 resend（只在后端使用）
JUNOHUB_EMAIL_PROVIDER=smtp
# Resend 方式使用以下配置
RESEND_API_KEY=
RESEND_FROM="JunoHub <noreply@example.com>"
# 每 24 小时全站最大发信尝试次数；邮箱提供商另有额度和风控限制
JUNOHUB_EMAIL_DAILY_LIMIT=100

# SMTP 注册验证码（后端配置；授权码不要提交 Git）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 图片存储：个人头像 JunoHub/user/，供应商头像 JunoHub/provider/
# 由服务端签名上传和读取，Bucket 可保持私有；凭据仅配置在服务端。
OSS_BUCKET=juno-app
OSS_REGION=cn-beijing
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PREFIX=JunoHub
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 仅临时 STS 凭据需要此项
OSS_SECURITY_TOKEN=

# 专用 /metrics 采集凭据。留空时仅允许管理员 JWT。
JUNOHUB_METRICS_TOKEN=
